<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FuncionarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Cadastro de Funcionários Piquiras" />

    <!-- Formulário de Entrada -->
    <HBox spacing="10.0">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Nome:" />
            <TextField fx:id="txtNome" promptText="Ex: João Gabriel" />
        </VBox>
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Cargo:" />
            <TextField fx:id="txtCargo" promptText="Ex: garçon" />
        </VBox>
        <VBox prefWidth="140.0" spacing="4.0">
            <Label text="Salário (R$):" />
            <TextField fx:id="txtSalario" promptText="Ex: 5500.00" />
        </VBox>
    </HBox>

    <!-- Botões do CRUD -->
    <HBox spacing="10.0">
        <Button fx:id="btnSalvar" onAction="#handleSalvar" style="-fx-background-color: green; -fx-text-fill: white;" text="Cadastrar" />
        <Button fx:id="btnAtualizar" disable="true" onAction="#handleAtualizar" style="-fx-background-color: gray; -fx-text-fill: white;" text="Atualizar" />
        <Button fx:id="btnDeletar" disable="true" onAction="#handleDeletar" style="-fx-background-color: red; -fx-text-fill: white;" text="Excluir" />
        <Button onAction="#limparCampos" style="-fx-background-color: gray; -fx-text-fill: white;" text="Limpar" />
    </HBox>

    <!-- TableView de Listagem -->
    <TableView fx:id="tabelaFuncionarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colNome" prefWidth="220.0" text="Nome" />
            <TableColumn fx:id="colCargo" prefWidth="180.0" text="Cargo" />
            <TableColumn fx:id="colSalario" prefWidth="120.0" text="Salário" />
        </columns>
    </TableView>
</VBox>
